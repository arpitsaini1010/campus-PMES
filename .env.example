# Campus PMES - Environment Variables Template
# Copy this file to .env and configure with your actual database and secret credentials.

# Application Environment
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection URI
# e.g., mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campus_pmes?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campus_pmes?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_strong_random_jwt_secret_key_here

# Default System Administrator Setup (Auto-seeded on first server boot)
ADMIN_EMAIL=admin@cpur.in
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME=System Administrator

# Client Origin (Leave empty if running unified full-stack service on Render)
CLIENT_URL=

